# ---- Backend (copy to backend/.env or export in the shell) ----
# Gemini API key for the reasoning agent. Never exposed to the frontend.
# Leave empty to run the deterministic fallback agent (same tool workflow, templated explanation).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when GEMINI_MODEL cannot serve a run (daily quota, outage, retired model); then the deterministic agent
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview
# auto = Gemini (then the fallback models, then the deterministic agent); gemini = Gemini only, an outage is an error;
# deterministic = never call Gemini. The simulator's Settings panel picks per run.
AGENT_MODE=auto
# Allow the backend to download fresh orbital data from CelesTrak (set false for fully offline use)
ALLOW_NETWORK=true
# Directory for downloaded orbital data (relative to repo root)
DATA_CACHE_DIR=data/cache
# CORS origins for the Vite dev server
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Frontend (copy to frontend/.env.local) ----
VITE_API_BASE_URL=http://localhost:8000
# Optional Cesium ion token for photographic world imagery on the simulator's globe. Without it
# the globe is the same vector-drawn Earth as the home page (Natural Earth coastlines, offline).
VITE_CESIUM_ION_TOKEN=
